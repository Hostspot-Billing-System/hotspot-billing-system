## Omega Hotspot Backend – Example Environment Variables

# --- Email (Resend) ---
# Required for password reset, login OTP, and diagnostics
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Omega WiFi <noreply@yourdomain.com>

# --- Session Secret ---
SESSION_SECRET=your_session_secret_here

# --- Frontend URL (CORS) ---
FRONTEND_URL=https://your-frontend.pages.dev

# --- Database ---
# For Supabase on local dev / Render, prefer the Session Pooler URL from the Connect dialog.
# Example:
# DATABASE_URL=postgresql://postgres.<project-ref>:[password]@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
PGSSL=true

# --- Node Environment ---
NODE_ENV=development

# --- Health Endpoint Details ---
# HEALTH_DETAILS=true
# --- Sessions ---
SESSION_SECRET=

# --- Email via Resend ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Must be a verified sender/domain in Resend, e.g. "Omega WiFi <no-reply@yourdomain.com>"
EMAIL_FROM=

# --- Login OTP SMS fallback ---
# Optional fallback destination for admin login OTP when owner profile phone_number is blank.
LOGIN_OTP_SMS_TO=0707434218

# --- Database (required by this backend) ---
# Use DATABASE_URL (recommended) OR set PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE
DATABASE_URL=
